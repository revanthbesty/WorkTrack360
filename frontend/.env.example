# Public frontend configuration only. Never put secrets in VITE_* variables.
# Register this app as a public OIDC client using Authorization Code + PKCE.
# Set the exact redirect URI to http://localhost:5173/auth/callback for local development.
VITE_OIDC_AUTHORITY=
VITE_OIDC_CLIENT_ID=
VITE_OIDC_REDIRECT_URI=http://localhost:5173/auth/callback
VITE_OIDC_POST_LOGOUT_REDIRECT_URI=http://localhost:5173/
VITE_OIDC_SCOPE=openid profile email

# Leave empty to use Vite's same-origin /api proxy.
VITE_API_BASE_URL=
