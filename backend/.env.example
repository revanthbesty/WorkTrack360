# Copy to .env for local use. Never commit actual credentials.
APP_ENV=development
APP_NAME=WorkTrack360 API
API_PREFIX=/api/v1
DATABASE_URL=postgresql+psycopg://worktrack:change-me@localhost:5432/worktrack360
APP_SECRET_KEY=replace-with-a-long-random-secret-before-running
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
